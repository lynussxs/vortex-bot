# Required to connect the Discord bot. Never commit real tokens.
DISCORD_TOKEN=

# Required to enable OpenRouter-backed AI responses.
OPENROUTER_API_KEY=

# Optional runtime configuration.
AI_MODEL=openai/gpt-4o-mini
DATABASE_PATH=/data/mybot.db
OWNER_ID=
DEV_GUILD_ID=
AI_MAX_TOKENS=500
AI_COOLDOWN=10
LOG_LEVEL=INFO
